{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/safety_guard.py",
            "timeout": 10,
            "statusMessage": "Checking against safety rules..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/lint_check.py",
            "timeout": 30,
            "statusMessage": "Running ruff + mypy --strict..."
          }
        ]
      }
    ]
  }
}
