# Environment Settings

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/agentic_engine

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# MCP Sandbox
MCP_SERVER_URL=http://127.0.0.1:8080/sse

# LLM Factory (Options: mock, openai, vertex, gemini, bedrock, groq)
LLM_PROVIDER=mock

# API Keys (Fill the ones you need based on LLM_PROVIDER)
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GROQ_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Langfuse Telemetry (Optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# System Guardrails
MAX_LLM_RETRIES=3
IDEMPOTENCY_TTL_SECONDS=86400
EXPERT_SYSTEM_CONFIDENCE_THRESHOLD=0.85
KALMAN_ALERT_SIGMA=2.0
