# Environment Settings

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/agentic_engine
# Test suite only. Empty = DATABASE_URL's database name + "_test". Must end in _test.
TEST_DATABASE_URL=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# MCP Sandbox
MCP_SERVER_URL=http://127.0.0.1:8080/sse

# Phase 4 Ops Dashboard (Streamlit) -- the gateway URL it consumes; the
# dashboard never talks to Postgres or the MCP server directly.
GATEWAY_URL=http://localhost:8000

# MCP Security Boundary (Phase 1.B)
# Server side: path to the client registry (client_id -> token hash -> allowed tools).
MCP_CLIENTS_FILE=mcp_clients.json
# Worker side: this worker's bearer token. Must match a token_hash entry in
# MCP_CLIENTS_FILE (SHA-256 of this value). The default below matches the
# committed mcp_clients.json for local dev only -- rotate both for any shared
# or production deployment.
MCP_CLIENT_TOKEN=local-dev-worker-token-change-me
REFUND_MAX_AMOUNT=10000
MCP_RATE_LIMIT_PER_MIN=30
# Server side: extra comma-separated Host headers the MCP transport accepts
# (e.g. the Cloud Run hostname). Empty locally: the defaults cover compose.
MCP_ALLOWED_HOSTS=
MCP_TOOL_TIMEOUT_SECONDS=10
MCP_TOOL_MAX_RETRIES=3
MCP_TOOL_BACKOFF_BASE_SECONDS=1.0

# LLM Factory (Options: mock, openai, vertex, gemini, bedrock, groq)
LLM_PROVIDER=mock

# API Keys (Fill the ones you need based on LLM_PROVIDER)
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GROQ_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Vertex AI (LLM_PROVIDER=vertex). Auth via ADC: `gcloud auth application-default login`
# locally, the service account on Cloud Run. Empty VERTEX_PROJECT = ADC's project.
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_EMBEDDING_LOCATION=us-central1
# Chat model for the Gemini roles: Judge 1 and the Supreme Court share it today.
VERTEX_MODEL=gemini-3.5-flash-lite
# RAG embeddings. Must stay a 768-dim model: it has to match knowledge_base.embedding.
VERTEX_EMBEDDING_MODEL=gemini-embedding-001

# --- Vertex model catalog, by role (reference only, NOT read by the code yet) ---
# Per-role models arrive with the feat/model-benchmark branch. Every Gemini ID
# below answered from this project on location=global (2026-09-23). USD per 1M
# tokens in/out, list prices fetched 2026-09-23 (Gemini: AI Studio paid tier;
# Claude: Anthropic list, global endpoint, +10% on regional ones; Grok: xAI list).
# Confirm on the Vertex pricing page before relying on them.
# [ref] = reference price only: partner models (Claude, Grok) can't be enabled on
# the GCP free-trial credit, so they aren't part of the benchmark.
#
# Judge 1 -- runs on every claim, Gemini family, fast and cheap:
#   gemini-3.5-flash-lite    $0.30 / $2.50   current default, no visible thinking
#   gemini-3.1-flash-lite    $0.25 / $1.50   cheapest candidate
# Judge 2 -- runs on every claim, MUST be a different family from Judge 1:
#   claude-haiku-4-5         $1.00 / $5.00   [ref] needs a paid billing account
#   openai/gpt-oss-20b       $0.075 / $0.30  on Groq (current), the only non-Gemini family available
#   grok-4.20 non-reasoning  $1.25 / $2.50   [ref] xAI list price
# Supreme Court -- only on disagreement, strongest reasoning per dollar. Ideally a
# third family so the tie-break is independent; with Gemini only, a stronger Gemini:
#   gemini-3.8-flash         $0.75 / $3.75   thinking model; $1.50 / $7.50 from 2027-01-01
#   grok-4.20 reasoning      $1.25 / $2.50   [ref] xAI list price, plus reasoning tokens
#   claude-sonnet-5          $2.00 / $10.00  [ref] rejects `temperature`
# Primary agent / Front-Desk (Phase 1.E, not built yet):
#   gemini-3.8-flash         $0.75 / $3.75
#   claude-sonnet-5          $2.00 / $10.00  [ref]

# Langfuse Telemetry (Optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# System Guardrails
MAX_LLM_RETRIES=3
IDEMPOTENCY_TTL_SECONDS=86400
EXPERT_SYSTEM_CONFIDENCE_THRESHOLD=0.85
KALMAN_ALERT_SIGMA=2.0

# LANGCHAIN
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="tu_api_key_de_langsmith"
LANGCHAIN_PROJECT="agentic-mcp-engine"

# System Guardrails (not configuret yet, example)
MAX_LLM_RETRIES=3
IDEMPOTENCY_TTL_SECONDS=86400
EXPERT_SYSTEM_CONFIDENCE_THRESHOLD=0.85
KALMAN_ALERT_SIGMA=2.0